# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local LLM model binaries — never commit (multi-GB). See docs/LOCAL_AI.md.
*.gguf
*.litertlm
/models/

# Speech-to-text model binaries (sherpa-onnx etc.) — never commit.
*.onnx
*.ort
*.tar.bz2
/stt_models/

# Build outputs and packages.
*.apk
*.aab
*.ipa

# Secrets, signing material and machine-local configuration.
.env
.env.*
*.keystore
*.jks
*.p12
*.mobileprovision
key.properties
local.properties

# Editor / scratch leftovers.
*.tmp

# Audio recordings: the app never writes any; keep stray test captures out.
*.wav
*.pcm
*.m4a
*.mp3

# Local benchmark / spike working folders.
/sweep/

# Benchmark, spike and acceptance evidence is committed on purpose
# (overrides *.log). Review it for personal data before committing.
!docs/benchmark_logs/**/*.log
!docs/stt_spike/**/*.log
!docs/test_evidence/**/*.log
